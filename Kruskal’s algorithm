#include <iostream>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, weight;
};

bool compare(Edge a, Edge b) {
    return a.weight < b.weight;
}

int parent[10];

int find(int i) {
    if (parent[i] == i)
        return i;

    return parent[i] = find(parent[i]);
}

void unionSet(int u, int v) {
    parent[find(u)] = find(v);
}

int main() {
    int n = 5;
    int e = 7;

    Edge edges[] = {
        {0, 1, 2},
        {0, 3, 6},
        {1, 2, 3},
        {1, 3, 8},
        {1, 4, 5},
        {2, 4, 7},
        {3, 4, 9}
    };

    sort(edges, edges + e, compare);

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int total = 0;

    cout << "Edges in Minimum Spanning Tree:\n";

    for (int i = 0; i < e; i++) {
        int u = edges[i].u;
        int v = edges[i].v;

        if (find(u) != find(v)) {
            cout << u << " - " << v
                 << " : " << edges[i].weight << endl;

            unionSet(u, v);
            total += edges[i].weight;
        }
    }

    cout << "Minimum Cost = " << total << endl;

    return 0;
}

